# Runtime connection for the long-lived Cloudflare Container. Copy the exact
# Session pooler URL (port 5432) from Supabase's Connect dialog. The pooler user
# is ROLE.PROJECT_REF; do not infer its aws-N hostname from the project region.
DATABASE_URL=postgresql://sdms_app.PROJECT_REF:YOUR_PERCENT_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&search_path=sdms&TimeZone=Asia/Bangkok

# Prefer a direct connection for migrations. If the machine running migrations
# has no IPv6 route, use the Session pooler URL above instead. The command
# `go run ./cmd/migrate` automatically prefers this variable when it is set.
MIGRATION_DATABASE_URL=postgresql://sdms_app:YOUR_PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&search_path=sdms&TimeZone=Asia/Bangkok

# A shared Transaction pooler URL uses port 6543. The app detects that endpoint
# and disables pgx implicit prepared statements automatically. Override only
# for a non-standard compatible proxy: DB_PREFER_SIMPLE_PROTOCOL=true
DB_MAX_IDLE_CONNS=2
DB_MAX_OPEN_CONNS=10
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=5m

# Cloudflare R2 S3-compatible credentials.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sdms-bucket
