# Supabase direct connection for the long-lived Cloudflare Container.
# Use the dedicated least-privilege role, keep sslmode=require and
# search_path=sdms, and percent-encode reserved password characters.
DATABASE_URL=postgresql://sdms_app:YOUR_PERCENT_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require&search_path=sdms&TimeZone=Asia/Bangkok

# On an IPv4-only host, copy the exact Session pooler URL from Supabase's
# Connect dialog. Do not infer its aws-N hostname from the project region.

# Cloudflare R2 S3-compatible credentials.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sdms-bucket
