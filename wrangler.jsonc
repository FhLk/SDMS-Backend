{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sdms-backend",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-22",
	"workers_dev": true,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"containers": [
		{
			"class_name": "SDMSContainer",
			"scheduling_policy": "durable_object",
			"images": {
				"base": {
					"dockerfile": "./Dockerfile"
				}
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SDMS_CONTAINER",
				"class_name": "SDMSContainer"
			}
		]
	},
	"exports": {
		"SDMSContainer": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"secrets": {
		"required": [
			"DATABASE_URL",
			"R2_ACCOUNT_ID",
			"R2_ACCESS_KEY_ID",
			"R2_SECRET_ACCESS_KEY",
			"R2_BUCKET"
		]
	}
}
