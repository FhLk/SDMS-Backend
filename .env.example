# HTTP server สำหรับทดสอบบนเครื่อง
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# PostgreSQL local จาก compose.yaml
DATABASE_URL=postgres://sdms:sdms@localhost:5432/sdms?sslmode=disable&TimeZone=Asia/Bangkok
DB_SCHEMA=sdms
DB_CONNECT_TIMEOUT=5s
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h

# Session cookie สำหรับ HTTP บนเครื่องเท่านั้น
SESSION_TTL=24h
SESSION_COOKIE_NAME=sdms_session
SESSION_COOKIE_SECURE=false

# ใช้ local storage ระหว่างพัฒนา และเปลี่ยนเป็น r2 เมื่อนำขึ้น production
FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
STAGED_UPLOAD_TTL=24h
UPLOAD_CLEANUP_INTERVAL=1h

# กำหนดค่าเหล่านี้เมื่อเปลี่ยน FILE_STORAGE_DRIVER เป็น r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sdms-files
# R2_PREFIX=sdms
# R2_SESSION_TOKEN=
# R2_ENDPOINT=
