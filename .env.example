SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# DATABASE_URL takes precedence over the DB_* values below when it is set.
# DATABASE_URL=postgres://sdms:sdms@localhost:5432/sdms?sslmode=disable&TimeZone=Asia/Bangkok
DB_HOST=localhost
DB_PORT=5432
DB_USER=sdms
DB_PASSWORD=sdms
DB_NAME=sdms
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

DB_CONNECT_TIMEOUT=5s
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h

# Browser session. Set SESSION_COOKIE_SECURE=true when the API is served over HTTPS.
SESSION_TTL=24h
SESSION_COOKIE_NAME=sdms_session
SESSION_COOKIE_SECURE=false

# Optional values used by `go run ./cmd/create-admin` only.
# Prefer setting INITIAL_ADMIN_PASSWORD temporarily instead of committing it here.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=ผู้ดูแลระบบ
# INITIAL_ADMIN_POSITION=ผู้ดูแลระบบ

