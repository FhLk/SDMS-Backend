SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# DATABASE_URL takes precedence over the DB_* values below when it is set.
# DATABASE_URL=postgres://sdms:sdms@localhost:5432/sdms?sslmode=disable&TimeZone=Asia/Bangkok
DB_HOST=localhost
DB_PORT=5432
DB_USER=sdms
DB_PASSWORD=sdms
DB_NAME=sdms
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

DB_CONNECT_TIMEOUT=5s
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h

# Browser session. Set SESSION_COOKIE_SECURE=true when the API is served over HTTPS.
SESSION_TTL=24h
SESSION_COOKIE_NAME=sdms_session
SESSION_COOKIE_SECURE=false

# ที่เก็บไฟล์: ใช้ local ตอนพัฒนา และสลับเป็น r2 ใน production.
FILE_STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
STAGED_UPLOAD_TTL=24h
UPLOAD_CLEANUP_INTERVAL=1h

# ต้องกำหนดเมื่อ FILE_STORAGE_DRIVER=r2 โดยสร้าง Access Key ที่จำกัดสิทธิ์เฉพาะ bucket นี้.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=sdms-files
# R2_PREFIX=sdms
# R2_SESSION_TOKEN=        # ใส่เฉพาะเมื่อใช้ temporary credentials
# R2_ENDPOINT=             # ไม่ส่งจะใช้ https://<account-id>.r2.cloudflarestorage.com

# Optional values used by `go run ./cmd/create-admin` only.
# Prefer setting INITIAL_ADMIN_PASSWORD temporarily instead of committing it here.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_NAME=ผู้ดูแลระบบ
# INITIAL_ADMIN_POSITION=ผู้ดูแลระบบ

