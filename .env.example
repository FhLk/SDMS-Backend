APP_ENV=development
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=sdms
DB_PASSWORD=change-me
DB_NAME=sdms_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=100

# Production must use a long, random secret. The API refuses to start in
# APP_ENV=production when this remains the development fallback.
AUTH_JWT_SECRET=change-this-to-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=24

# Optional location used by scripts/backup.sh
BACKUP_DIR=backups
