SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# DATABASE_URL takes precedence over the DB_* values below when it is set.
# DATABASE_URL=postgres://sdms:sdms@localhost:5432/sdms?sslmode=disable&TimeZone=Asia/Bangkok
DB_HOST=localhost
DB_PORT=5432
DB_USER=sdms
DB_PASSWORD=sdms
DB_NAME=sdms
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

DB_CONNECT_TIMEOUT=5s
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h

